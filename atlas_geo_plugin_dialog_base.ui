<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AtlasGeoHandlerDemoDialogBase</class>
 <widget class="QDialog" name="AtlasGeoHandlerDemoDialogBase">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>740</width><height>600</height></rect>
  </property>
  <property name="windowTitle">
   <string>ATLAS-GEO</string>
  </property>
  <property name="font">
   <font>
    <family>Segoe UI</family>
    <pointsize>11</pointsize>
    <weight>50</weight>
   </font>
  </property>
  <property name="styleSheet">
   <string>
/* ═══════════════════════════════════════════════
   ATLAS GEO — AIVE AI Systems  |  2026 Modern UI
   Font:    "Segoe UI", "-apple-system", "system-ui" › 500/600
   Mono:    "SF Mono", "Monaco", "Menlo" › system monospace
   Design:  Clean, spacious, modern typography hierarchy
════════════════════════════════════════════════ */

/* ── Base Dialog ───────────────────────────────── */
QDialog {
    background-color: #f5f0e8;
    color: #1a1612;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
    font-size: 14px;
    font-weight: 500;
}
QStackedWidget { background-color: #f5f0e8; }

/* ── Header Bar ────────────────────────────────── */
QFrame#label_header_bar { background-color: #1a1612; }

/* ── Page Titles (Primary Headings) ────────────── */
QLabel#label_getstarted_title,
QLabel#label_signin_title,
QLabel#label_signup_title,
QLabel#label_reset_title,
QLabel#label_screen1_title,
QLabel#label_screen2_title,
QLabel#label_screen3_title {
    font-size: 26px;
    font-weight: 600;
    color: #1a1612;
    letter-spacing: -0.2px;
    line-height: 1.3;
}
QLabel#label_screen3_title { color: #059669; }

/* ── Subtitles (Secondary Headings) ────────────── */
QLabel#label_getstarted_subtitle,
QLabel#label_signin_subtitle,
QLabel#label_signup_subtitle,
QLabel#label_reset_subtitle,
QLabel#label_screen1_subtitle,
QLabel#label_screen2_subtitle {
    font-size: 14px;
    color: #78716c;
    font-weight: 400;
    line-height: 1.5;
}

/* ── Step Badge Pills ──────────────────────────── */
QLabel#label_step_indicator,
QLabel#label_step_indicator_2 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #ea580c;
    background-color: #fff4ed;
    padding: 4px 12px;
    border-radius: 14px;
    border: 1px solid #fed7aa;
    font-family: "Monaco", "Menlo", "Consolas", monospace;
}
QLabel#label_step_indicator_3 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #059669;
    background-color: #ecfdf5;
    padding: 4px 12px;
    border-radius: 14px;
    border: 1px solid #a7f3d0;
    font-family: "Monaco", "Menlo", "Consolas", monospace;
}

/* ── GroupBoxes (Cards) ────────────────────────── */
QGroupBox {
    border: 1px solid #e7ded2;
    border-radius: 14px;
    margin-top: 18px;
    padding-top: 20px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    color: #a8a096;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
    background-color: #ffffff;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 18px;
    padding: 2px 10px;
    color: #a8a096;
    background-color: #ffffff;
}

/* ── Text Inputs ───────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #faf7f2;
    border: 1px solid #e4dccf;
    border-radius: 10px;
    padding: 11px 14px;
    color: #1a1612;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
    selection-background-color: #ea580c;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #ea580c;
    background-color: #ffffff;
    padding: 10px 13px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #ccbda8;
    background-color: #ffffff;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #f1ece4;
    color: #b8b0a6;
}
QLineEdit::placeholder { color: #bbb2a7; font-weight: 400; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 18px; border: none; background: transparent;
}

/* ── ComboBox ──────────────────────────────────── */
QComboBox {
    background-color: #faf7f2;
    border: 1px solid #e4dccf;
    border-radius: 10px;
    padding: 11px 14px;
    color: #1a1612;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QComboBox:hover { border: 1px solid #ccbda8; background-color: #ffffff; }
QComboBox:focus, QComboBox:on { border: 2px solid #ea580c; background-color: #ffffff; }
QComboBox::drop-down {
    border: none; width: 34px;
    subcontrol-origin: padding; subcontrol-position: center right;
}
QComboBox::down-arrow { width: 11px; height: 11px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e4dccf;
    border-radius: 10px;
    color: #1a1612;
    font-size: 14px;
    font-weight: 500;
    selection-background-color: #fff4ed;
    selection-color: #ea580c;
    padding: 6px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 10px;
    border-radius: 7px;
}

/* ── Checkbox ──────────────────────────────────── */
QCheckBox {
    color: #44403c;
    font-size: 14px;
    font-weight: 500;
    spacing: 10px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #d6cfca;
    border-radius: 6px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f4691c, stop:1 #ea580c);
    border-color: #ea580c;
}
QCheckBox::indicator:checked:hover { border-color: #c2410c; }
QCheckBox::indicator:hover { border-color: #ea580c; background-color: #fff7f1; }

/* ══ PRIMARY BUTTONS ══ */
QPushButton#btn_next_setup,
QPushButton#btn_get_started,
QPushButton#btn_signin,
QPushButton#btn_do_signup,
QPushButton#btn_do_reset {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f4691c, stop:1 #ea580c);
    color: #ffffff;
    border: none;
    border-bottom: 2px solid #c2410c;
    border-radius: 10px;
    padding: 12px 28px;
    font-size: 14px;
    font-weight: 600;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
    letter-spacing: 0.2px;
}
QPushButton#btn_next_setup:hover,
QPushButton#btn_get_started:hover,
QPushButton#btn_signin:hover,
QPushButton#btn_do_signup:hover,
QPushButton#btn_do_reset:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ea580c, stop:1 #d2480a);
    border-bottom-color: #9a3412;
}
QPushButton#btn_next_setup:pressed,
QPushButton#btn_get_started:pressed,
QPushButton#btn_signin:pressed,
QPushButton#btn_do_signup:pressed,
QPushButton#btn_do_reset:pressed {
    background: #c2410c;
    border-bottom: none;
    padding-top: 14px;
}
QPushButton#btn_next_setup:disabled,
QPushButton#btn_get_started:disabled,
QPushButton#btn_signin:disabled,
QPushButton#btn_do_signup:disabled,
QPushButton#btn_do_reset:disabled {
    background: #ece6dd;
    color: #b5aea6;
    border-bottom: 2px solid #ddd5ca;
}

/* ══ SECONDARY BUTTONS ══ */
QPushButton#btn_cancel_processing,
QPushButton#btn_signin_back,
QPushButton#btn_signup_back,
QPushButton#btn_reset_back,
QPushButton#btn_new_mission {
    background-color: #ffffff;
    color: #57534e;
    border: 1px solid #e2ddd8;
    border-radius: 10px;
    padding: 11px 26px;
    font-size: 14px;
    font-weight: 600;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_cancel_processing:hover,
QPushButton#btn_signin_back:hover,
QPushButton#btn_signup_back:hover,
QPushButton#btn_reset_back:hover,
QPushButton#btn_new_mission:hover {
    background-color: #faf7f2;
    color: #1a1612;
    border-color: #ccbda8;
}
QPushButton#btn_cancel_processing:pressed,
QPushButton#btn_signin_back:pressed,
QPushButton#btn_signup_back:pressed,
QPushButton#btn_reset_back:pressed,
QPushButton#btn_new_mission:pressed {
    background-color: #f3ece3;
}

/* ══ SUCCESS / VIEW MAP ══ */
QPushButton#btn_view_map {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #14c98e, stop:1 #10b981);
    color: #ffffff;
    border: none;
    border-bottom: 2px solid #059669;
    border-radius: 10px;
    padding: 12px 28px;
    font-size: 14px;
    font-weight: 600;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_view_map:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10b981, stop:1 #059669);
    border-bottom-color: #047857;
}
QPushButton#btn_view_map:pressed {
    background: #047857;
    border-bottom: none;
    padding-top: 14px;
}

/* ══ EXPORT BUTTON ══ */
QPushButton#btn_export_report {
    background-color: transparent;
    color: #ea580c;
    border: 1px solid #fed7aa;
    border-radius: 9px;
    padding: 11px 26px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_export_report:hover { background-color: #fff4ed; border-color: #f97316; }

/* ══ FEEDBACK BUTTON ══ */
QPushButton#btn_feedback,
QPushButton#btn_feedback_results {
    background-color: transparent;
    color: #7c3aed;
    border: 1px solid #ddd6fe;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_feedback:hover,
QPushButton#btn_feedback_results:hover { background-color: #f5f3ff; border-color: #7c3aed; }

/* ══ BROWSE BUTTON ══ */
QPushButton#btn_browse_setup {
    background-color: #ffffff;
    color: #57534e;
    border: 1px solid #e8e2d8;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_browse_setup:hover { background-color: #fff4ed; color: #ea580c; border-color: #f97316; }

/* ══ SIGN UP / FORGOT BUTTONS ══ */
QPushButton#btn_signup {
    background-color: #fff4ed;
    color: #ea580c;
    border: 1px solid #fed7aa;
    border-radius: 7px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_signup:hover { background-color: #ffedd5; border-color: #f97316; }

QPushButton#btn_forgot_password {
    background-color: transparent;
    color: #ea580c;
    border: none;
    padding: 0;
    font-size: 12px;
    font-weight: 500;
    text-decoration: underline;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_forgot_password:hover { color: #c2410c; }

QPushButton#btn_send_reset_code {
    background-color: #ffffff;
    color: #57534e;
    border: 1px solid #e8e2d8;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
}
QPushButton#btn_send_reset_code:hover { background-color: #fff4ed; border-color: #f97316; color: #ea580c; }

/* ══ PROGRESS BAR ══ */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #ece6dd;
    min-height: 12px;
    max-height: 12px;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #fb923c, stop:0.55 #ea580c, stop:1 #c2410c);
    border-radius: 6px;
}

/* ══ DROP ZONE ══ (dashed box is now the FRAME so the Browse button sits inside) */
QFrame#frame_drop_zone {
    border: 2px dashed #d6cfca;
    border-radius: 10px;
    background-color: #faf8f4;
}
QFrame#frame_drop_zone:hover { border-color: #ea580c; background-color: #fff4ed; }
QLabel#label_drop_zone {
    color: #a8a29e;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
    border: none;
}

/* ══ PIPELINE STATUS ITEMS ══ */
QLabel#label_status_upload,
QLabel#label_status_analyze,
QLabel#label_status_match,
QLabel#label_status_prepare {
    color: #57534e;
    padding: 9px 16px;
    background-color: #faf8f4;
    border-left: 3px solid #e8e2d8;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 500;
    font-family: "Monaco", "Menlo", "Consolas", monospace;
    line-height: 1.4;
}

/* ══ INSIGHT METRIC TILES ══ */
QLabel#label_insight_quality {
    color: #059669;
    font-size: 12px;
    font-weight: 600;
    padding: 9px 16px;
    background-color: #ecfdf5;
    border-radius: 7px;
    border-left: 3px solid #10b981;
    font-family: "Monaco", "Menlo", "Consolas", monospace;
    line-height: 1.4;
}
QLabel#label_insight_speed {
    color: #ea580c;
    font-size: 12px;
    font-weight: 600;
    padding: 9px 16px;
    background-color: #fff4ed;
    border-radius: 7px;
    border-left: 3px solid #ea580c;
    font-family: "Monaco", "Menlo", "Consolas", monospace;
    line-height: 1.4;
}
QLabel#label_insight_eta {
    color: #92400e;
    font-size: 12px;
    font-weight: 600;
    padding: 9px 16px;
    background-color: #fffbeb;
    border-radius: 7px;
    border-left: 3px solid #f59e0b;
    font-family: "Monaco", "Menlo", "Consolas", monospace;
    line-height: 1.4;
}

/* ══ SUCCESS CHECKMARK ══ */
QLabel#label_checkmark { color: #10b981; font-size: 80px; }

/* ══ DIVIDER LINES ══ */
QFrame[frameShape="4"] { background-color: #e8e2d8; max-height: 1px; border: none; }

/* ══ PROGRESS % LABEL ══ */
QLabel#label_progress_percent {
    font-size: 14px;
    font-weight: 700;
    color: #ea580c;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
    background-color: #fff4ed;
    padding: 4px 12px;
    border-radius: 7px;
    border: 1px solid #fed7aa;
    min-width: 48px;
}

/* ══ GENERIC LABELS ══ */
QLabel {
    color: #57534e;
    font-size: 14px;
    font-weight: 500;
    font-family: "Segoe UI", "-apple-system", "system-ui", sans-serif;
    background-color: transparent;
    line-height: 1.5;
}

/* ══ SCROLLBARS (thin, modern, overlay-style) ══ */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px 2px 2px 0;
}
QScrollBar::handle:vertical {
    background: #d8cfc4;
    min-height: 36px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #c2410c; }
QScrollBar::handle:vertical:pressed { background: #9a3412; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0 2px 2px 2px;
}
QScrollBar::handle:horizontal {
    background: #d8cfc4;
    min-width: 36px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #c2410c; }
QScrollBar::handle:horizontal:pressed { background: #9a3412; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ══ SCROLL AREAS ══ */
QScrollArea, QAbstractScrollArea { border: none; background: transparent; }

/* ══ TOOLTIPS (dark, rounded) ══ */
QToolTip {
    background-color: #1a1612;
    color: #f5f0e8;
    border: 1px solid #2c2620;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 500;
}

/* ══ CONTEXT MENUS ══ */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e4dccf;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 18px;
    border-radius: 7px;
    color: #44403c;
    font-size: 13px;
}
QMenu::item:selected { background-color: #fff4ed; color: #ea580c; }
QMenu::separator { height: 1px; background: #ece6dd; margin: 4px 8px; }
   </string>
  </property>

  <layout class="QVBoxLayout" name="verticalLayout_main">
   <property name="spacing"><number>0</number></property>
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>

   <!-- ═══ TOP BRAND BAR ═══ -->
   <item>
    <widget class="QFrame" name="label_header_bar">
     <property name="minimumHeight"><number>34</number></property>
     <property name="maximumHeight"><number>34</number></property>
     <property name="styleSheet"><string>QFrame#label_header_bar { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a1612, stop:1 #2b221a); border: none; border-bottom: 2px solid #ea580c; }</string></property>
     <layout class="QHBoxLayout">
      <property name="spacing"><number>8</number></property>
      <property name="leftMargin"><number>12</number></property>
      <property name="topMargin"><number>2</number></property>
      <property name="rightMargin"><number>12</number></property>
      <property name="bottomMargin"><number>2</number></property>
      <item>
       <widget class="QLabel" name="label_aive_logo">
        <property name="text"><string></string></property>
        <property name="alignment"><set>Qt::AlignCenter</set></property>
        <property name="styleSheet"><string>background: transparent; border: none;</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="label_header_wordmark">
        <property name="text"><string>&lt;b&gt;ATLAS·GEO&lt;/b&gt;&lt;span style="color:#6b5d52;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style="color:#c9b8a3; font-weight:600; font-size:10px;"&gt;AIVE&amp;nbsp;AI&amp;nbsp;SYSTEMS&lt;/span&gt;</string></property>
        <property name="styleSheet"><string>background: transparent; border: none; color: #ffffff; font-size: 12px; font-family: "Segoe UI", sans-serif;</string></property>
       </widget>
      </item>
      <item>
       <spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property></spacer>
      </item>
      <item>
       <widget class="QLabel" name="label_header_status">
        <property name="text"><string>v1.0</string></property>
        <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
        <property name="styleSheet"><string>background: transparent; border: none; color: #9a8f80; font-size: 10px; font-weight: 600; padding: 2px 4px;</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QStackedWidget" name="stacked_pages">
     <property name="currentIndex"><number>0</number></property>

     <!-- ══════════════════════════════════════════
          PAGE 0 — GET STARTED
     ══════════════════════════════════════════ -->
     <widget class="QWidget" name="page_getstarted">
      <layout class="QVBoxLayout" name="verticalLayout_getstarted">
       <property name="leftMargin"><number>32</number></property>
       <property name="topMargin"><number>44</number></property>
       <property name="rightMargin"><number>32</number></property>
       <property name="bottomMargin"><number>32</number></property>
       <property name="spacing"><number>14</number></property>

       <item>
        <widget class="QLabel" name="label_getstarted_title">
         <property name="text"><string>ATLAS-GEO</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="styleSheet">
          <string>font-size: 38px; font-weight: 800; color: #1a1612; letter-spacing: 1px;</string>
         </property>
        </widget>
       </item>

       <item>
        <widget class="QLabel" name="label_gs_brand">
         <property name="text"><string>UAV  GEOREFERENCING  ·  BY  AIVE  AI  SYSTEMS</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="styleSheet">
          <string>font-size: 11px; font-weight: 700; letter-spacing: 3px; color: #ea580c; font-family: "Monaco", "Menlo", "Consolas", monospace;</string>
         </property>
        </widget>
       </item>

       <item>
        <spacer>
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>16</height></size></property>
        </spacer>
       </item>

       <item>
        <widget class="QLabel" name="label_getstarted_description">
         <property name="text"><string>Accurately georeference UAV-captured imagery in seconds using advanced machine learning algorithms.

